{
  "name": "@hellonear/be",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "migrate": "node --env-file=.env --import tsx src/migrate.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:unit": "node --import tsx --test test/crypto.test.ts test/sse.test.ts test/approvals.test.ts",
    "load": "node --env-file-if-exists=.env --import tsx load/api.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "near-api-js": "7.4.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.9"
}
