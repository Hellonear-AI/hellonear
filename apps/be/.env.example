# NEAR network and the Mind registry contract (sc/)
NEAR_NETWORK=testnet
REGISTRY_CONTRACT_ID=hellonear-registry.testnet
# Postgres with pgvector (local: `docker compose up -d postgres` from the repo root)
DATABASE_URL=postgresql://hellonear:hellonear-dev-only@localhost:55432/hellonear
# The engine (engine/) and the shared secret sent in X-Engine-Key; same value as the engine's ENGINE_API_KEY
ENGINE_URL=http://localhost:4100
ENGINE_API_KEY=
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts stored secrets; losing it loses them.
SECRETS_MASTER_KEY=
# Optional, default 4000
PORT=4000
# Optional, default http://localhost:3000: the web app origin (CORS with credentials, CSRF check)
FE_ORIGIN=
# Optional, default hellonear.app: the NEP-413 `recipient` the wallet signs; the FE must send the same
AUTH_RECIPIENT=
# Optional, default https://rpc.testnet.near.org: RPC for checking the login key is a full-access key
NEAR_RPC_URL=
# Optional, default false: set true behind HTTPS so the session cookie is Secure
COOKIE_SECURE=
# Optional, defaults https://testnet-api.outlayer.ai and outlayer.testnet: the OutLayer wallet API and contract (Mind wallets)
OUTLAYER_URL=
OUTLAYER_CONTRACT_ID=
# Optional, default off: `true` enables POST /v1/auth/demo, the judge try-out mode (#43)
DEMO_MODE=
# Optional: the shared demo wallet's OutLayer agent key (wk_…), used by every try-out user's Mind (never commit it)
DEMO_OUTLAYER_API_KEY=
# Composio project API key (ak_…, from the developer dashboard; a personal "For you" ck_… key gets 401). Without it the connection routes answer 503
COMPOSIO_API_KEY=
# Optional, default https://backend.composio.dev/api/v3.1 (tests point it at a fake)
COMPOSIO_URL=
# Only for scripts/login-smoke.ts: a testnet account and one of its full-access keys (never commit them)
NEAR_TEST_ACCOUNT_ID=
NEAR_TEST_PRIVATE_KEY=

# OutLayer (testnet) agent wallet, written by spikes/01-outlayer/run.ts (never commit them; the handoff link contains the key)
OUTLAYER_API_KEY=
OUTLAYER_HANDOFF_URL=
OUTLAYER_SUB_SKILL_PAYMENTS=
