# NEAR network and the Mind registry contract (sc/)
NEAR_NETWORK=testnet
REGISTRY_CONTRACT_ID=hellonear-registry.testnet
# Postgres with pgvector (local: `docker compose up -d postgres` from the repo root)
DATABASE_URL=postgresql://hellonear:hellonear-dev-only@localhost:55432/hellonear
# The engine (engine/) and the shared secret sent in X-Engine-Key; same value as the engine's ENGINE_API_KEY
ENGINE_URL=http://localhost:4100
ENGINE_API_KEY=
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts stored secrets; losing it loses them.
SECRETS_MASTER_KEY=
# Optional, default 4000
PORT=4000
# Optional, default http://localhost:3000: the web app origin(s), comma-separated (CORS with credentials,
# CSRF check). The first one is the public web app: Composio sends the owner back there after connecting.
FE_ORIGIN=
# Optional, default hellonear.app: the NEP-413 `recipient` the wallet signs; the FE must send the same
AUTH_RECIPIENT=
# Optional, default https://rpc.testnet.near.org: RPC for checking the login key is a full-access key
NEAR_RPC_URL=
# Optional, default false: set true behind HTTPS so the session cookie is Secure
COOKIE_SECURE=
# Optional, defaults https://testnet-api.outlayer.ai and outlayer.testnet: the OutLayer wallet API and contract (Mind wallets)
OUTLAYER_URL=
OUTLAYER_CONTRACT_ID=
# Optional, default off: `true` enables POST /v1/auth/demo, the judge try-out mode (#43)
DEMO_MODE=
# Optional: the shared demo wallet's OutLayer agent key (wk_…), used by every try-out user's Mind (never commit it)
DEMO_OUTLAYER_API_KEY=
# Composio project API key (ak_…, from the developer dashboard; a personal "For you" ck_… key gets 401). Without it the connection routes answer 503
COMPOSIO_API_KEY=
# Optional, default https://backend.composio.dev/api/v3.1 (tests point it at a fake)
COMPOSIO_URL=
# AgentMail key (am_…, made by a person in the AgentMail console; never commit it): Minds' email addresses (#96).
# Without it the inbox and mail routes answer 503 agentmail_not_configured
AGENTMAIL_API_KEY=
# Optional: a second AgentMail organization's key; new inboxes go there once the first organization is full
AGENTMAIL_API_KEY_2=
# Optional, default https://api.agentmail.to/v0 (tests point it at a fake)
AGENTMAIL_URL=
# Optional: the shared try-out inbox's address (= its AgentMail inbox id, on AGENTMAIL_API_KEY), e.g. hellonear-demo@agentmail.to
DEMO_AGENTMAIL_INBOX=
# Optional: the testnet account a Mind pays for a Paid data report (#150). It must be on the paying wallet's address list
# (the demo wallet's, for try-outs). Empty: the shop answers 503 shop_not_configured
SHOP_PAY_TO=
# Optional, Best Price Buyer (#176): several sellers for the same items, account:multiplier separated by commas
# (e.g. a.testnet:1,b.testnet:0.8; price = base price x multiplier, up to 3 decimals). Each account must be on the paying
# wallet's address list. Empty: SHOP_PAY_TO is the only seller
SHOP_SELLERS=
# Telegram (#168). The public API URL Telegram calls for webhooks (e.g. https://api.hellonear.xyz); leave it empty locally
# and set TELEGRAM_POLLING=true to poll getUpdates instead. TELEGRAM_API_URL is for tests (default https://api.telegram.org).
TELEGRAM_WEBHOOK_BASE=
TELEGRAM_POLLING=
TELEGRAM_API_URL=
# Only for live checks: a test bot's token from @BotFather, made by a person (never commit it)
TELEGRAM_TEST_BOT_TOKEN=
# Only for scripts/login-smoke.ts: a testnet account and one of its full-access keys (never commit them)
NEAR_TEST_ACCOUNT_ID=
NEAR_TEST_PRIVATE_KEY=

# OutLayer (testnet) agent wallet, written by spikes/01-outlayer/run.ts (never commit them; the handoff link contains the key)
OUTLAYER_API_KEY=
OUTLAYER_HANDOFF_URL=
OUTLAYER_SUB_SKILL_PAYMENTS=
# Optional, default https://proof.t16z.com: Phala's TEE Attestation Explorer, where POST /v1/runs/{id}/proof/tee-explorer uploads a run's Intel quote (#277; tests point it at a fake)
TEE_EXPLORER_URL=
