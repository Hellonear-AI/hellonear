# NEAR AI Cloud (OpenAI-compatible, https://cloud-api.near.ai/v1)
NEARAI_API_KEY=
# Postgres with pgvector (local: `docker compose up -d postgres` from the repo root)
DATABASE_URL=postgresql://hellonear:hellonear-dev-only@localhost:55432/hellonear
# Shared secret the backend sends in the X-Engine-Key header
ENGINE_API_KEY=
# Optional, default 4100
PORT=4100
# NEAR network and the Mind registry contract (sc/)
NEAR_NETWORK=testnet
REGISTRY_CONTRACT_ID=hellonear-registry.testnet
# Optional NEAR RPC for read-only lookups, default https://rpc.testnet.near.org
NEAR_RPC_URL=
# Optional, default 14: workflow run snapshots and Autopilot fire history older than this many days are pruned hourly
RUN_RETENTION_DAYS=
# The backend's base URL, for the payment tools (#42) and mail tools (#96): they call its /internal/v1/wallet/* and
# /internal/v1/mail/* routes with ENGINE_API_KEY and the run's wallet or mail token. Local default setup: http://localhost:4000
BACKEND_URL=
# Composio project key (ak_…, from James, #13): owners' Gmail and Google Calendar for the email and calendar tools. Without it they answer "… is not connected"
COMPOSIO_API_KEY=
# Optional, default https://backend.composio.dev/api/v3.1 (tests point it at a fake)
COMPOSIO_URL=
# Optional, default https://1click.chaindefuser.com: NEAR Intents 1Click API for crosschain_quote (#273, dry quotes only, no key; tests point it at a fake)
ONECLICK_URL=
# Optional, default 12000: token budget for the messages of each model call; the oldest are trimmed first (#123)
CONTEXT_TOKEN_LIMIT=
