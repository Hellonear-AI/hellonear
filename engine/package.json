{
  "name": "@hellonear/engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "test": "node --env-file=.env --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test test/skills.test.ts test/templates.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.82",
    "@mastra/core": "1.81.0",
    "@mastra/memory": "1.40.0",
    "@mastra/pg": "1.34.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
