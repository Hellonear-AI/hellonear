# Copy to ~/.config/hellonear-autodeploy.env. No secrets here: gh and ssh use their own logins.
DEPLOY_HOST=root@192.168.18.11
DEPLOY_CT=215
# Optional
AUTODEPLOY_REPO=Hellonear-AI/hellonear
AUTODEPLOY_HEALTH_URL=https://api.hellonear.xyz/v1/health
# Mentioned in the PR comment when a deploy stops, rolls back or fails
AUTODEPLOY_NOTIFY=@Lin1er
